  m_Script: {fileID: 11500000, guid: b1c3b36bf9b50224cac64ec2398fa461, type: 3}
  m_Name: Phone_CASE09
  m_EditorClassIdentifier: Assembly-CSharp::PhoneDialogueDefinition
  incidentId: CASE09
  callerName: Encargado del Centro Civico
  lines:
  - speaker: ENCARGADO
    text: Buenas tardes. Estamos preparando un evento importante en Plaza Mayor.
  - speaker: ENCARGADO
    text: El altavoz del Centro Civico esta apagado. Enciendelo y ajusta el volumen entre 25 y 35.
  - speaker: PROTAGONISTA
    text: B10, entonces. Suena sencillo, pero tengo la sensacion de que se acerca algo grande.
  - speaker: OPERADORA
    text: Esta reparacion es importante. Vamos a necesitar tus equipos conectados.
