  m_Script: {fileID: 11500000, guid: b1c3b36bf9b50224cac64ec2398fa461, type: 3}
  m_Name: Phone_CASE03
  m_EditorClassIdentifier: Assembly-CSharp::PhoneDialogueDefinition
  incidentId: CASE03
  callerName: Vecina de Casa Almendro
  lines:
  - speaker: VECINA
    text: "\xA1Otra vez la television! Ahora esta en el canal Cine y queremos ver Local."
  - speaker: PROTAGONISTA
    text: Volvemos a Casa Almendro... aunque esta vez no hace falta caminar.
  - speaker: OPERADORA
    text: Pulsa TAB para abrir la terminal remota. Selecciona B01 y cambia de canal.
  - speaker: PROTAGONISTA
    text: Dejaremos el volumen en 30. Mira que la tecnologia bien usada ahorra piernas.
