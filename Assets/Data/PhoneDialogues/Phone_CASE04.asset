  m_Name: Phone_CASE04
  m_EditorClassIdentifier: Assembly-CSharp::PhoneDialogueDefinition
  incidentId: CASE04
  callerName: Florista del Barrio
  lines:
  - speaker: FLORISTA
    text: "\xA1Socorro! Hay una radio que no deja trabajar a nadie por aqui."
  - speaker: FLORISTA
    text: Creo que viene de Casa del Farol, junto a mi Floristeria.
  - speaker: PROTAGONISTA
    text: "B02, \xBFverdad? Mejor confirmamos antes de tocar el aparato equivocado."
  - speaker: FLORISTA
    text: "Bajala a 20 o menos, por favor. \xA1Mis plantas necesitan paz!"
