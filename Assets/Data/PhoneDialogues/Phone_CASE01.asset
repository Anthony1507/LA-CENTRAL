  m_Script: {fileID: 11500000, guid: b1c3b36bf9b50224cac64ec2398fa461, type: 3}
  m_Name: Phone_CASE01
  m_EditorClassIdentifier: Assembly-CSharp::PhoneDialogueDefinition
  incidentId: CASE01
  callerName: Central Vecinal / Primera jornada
  lines:
  - speaker: PROTAGONISTA
    text: Bien. Mi primer dia como tecnico de La Central. Doce edificios, un monton de aparatos... y tu al otro lado de la pantalla.
  - speaker: PROTAGONISTA
    text: Si, te estoy hablando a ti. Tu manejas las teclas y yo soluciono los problemas. Creo que sera un buen equipo.
  - speaker: OPERADORA
    text: "\xBFHola? \xBFMe escuchas? Tenemos nuestra primera queja vecinal."
  - speaker: VECINA
    text: "\xA1La television de Casa Almendro esta a todo volumen! \xA1No puedo dormir!"
  - speaker: PROTAGONISTA
    text: Entendido. Buscare la casa y bajare el televisor a 30 o menos.
  - speaker: PROTAGONISTA
    text: "Vamos, compa\xF1ero. Acercate a la puerta y pulsa E. Y no toques lo que no debes."
