  m_Script: {fileID: 11500000, guid: b1c3b36bf9b50224cac64ec2398fa461, type: 3}
  m_Name: Phone_CASE02
  m_EditorClassIdentifier: Assembly-CSharp::PhoneDialogueDefinition
  incidentId: CASE02
  callerName: Encargado del Cafe Esquina
  lines:
  - speaker: ENCARGADO
    text: "\xA1Buenas! Soy del Cafe Esquina. Nuestra radio esta tan bajita que ni se escucha."
  - speaker: ENCARGADO
    text: Necesito un volumen entre 35 y 50. No quiero que parezca una discoteca.
  - speaker: PROTAGONISTA
    text: Entendido. Un cafe con ambiente, no un concierto improvisado.
  - speaker: OPERADORA
    text: Al terminar esta reparacion activaremos tu terminal de acceso remoto.
